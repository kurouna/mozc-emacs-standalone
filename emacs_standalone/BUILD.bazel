load("//:build_defs.bzl", "mozc_cc_binary", "mozc_cc_library")

mozc_cc_library(
    name = "helper_lib",
    srcs = ["//unix/emacs:mozc_emacs_helper_lib.cc"],
    hdrs = ["//unix/emacs:mozc_emacs_helper_lib.h"],
    deps = [
        "//base:util",
        "//base/protobuf:descriptor",
        "//base/protobuf:message",
        "//composer:key_parser",
        "//protocol:candidate_window_cc_proto",
        "//protocol:commands_cc_proto",
    ],
)

mozc_cc_binary(
    name = "mozc_emacs_helper",
    srcs = ["mozc_emacs_helper_standalone.cc"],
    deps = [
        ":helper_lib",
        "//base:init_mozc",
        "//base:version",
        "//config:config_handler",
        "//engine:engine_factory",
        "//protocol:commands_cc_proto",
        "//session:session_handler",
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/flags:flag",
    ],
)
