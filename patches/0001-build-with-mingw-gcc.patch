     return TryGetLocalAppData(dir);
   } __except (EXCEPTION_EXECUTE_HANDLER) {
     return E_UNEXPECTED;
   }
+#else   // _MSC_VER
+  return TryGetLocalAppData(dir);
+#endif  // _MSC_VER
 }
 
